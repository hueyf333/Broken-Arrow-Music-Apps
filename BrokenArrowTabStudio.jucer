<?xml version="1.0" encoding="UTF-8"?>

<JUCERPROJECT id="brokAr" name="Broken Arrow Tab &amp; Score Studio" projectType="guiapp"
              useAppConfig="0" addUsingNamespaceToJuceHeader="0" jucerFormatVersion="1"
              companyName="Broken Arrow Music" companyCopyright="2025 Broken Arrow Music"
              companyWebsite="https://github.com/hueyf333/Broken-Arrow-Music-Apps"
              displaySplashScreen="0" reportAppUsage="0" splashScreenColour="Dark"
              cppLanguageStandard="20" headerPath="" defines="">
  <MAINGROUP id="mainGrp" name="Broken Arrow Tab &amp; Score Studio">
    <GROUP id="{source_group}" name="Source">
      <GROUP id="{model_group}" name="Model">
        <FILE id="note_h" name="Note.h" compile="0" resource="0" file="Source/Model/Note.h"/>
        <FILE id="note_cpp" name="Note.cpp" compile="1" resource="0" file="Source/Model/Note.cpp"/>
        <FILE id="measure_h" name="Measure.h" compile="0" resource="0" file="Source/Model/Measure.h"/>
        <FILE id="measure_cpp" name="Measure.cpp" compile="1" resource="0" file="Source/Model/Measure.cpp"/>
        <FILE id="track_h" name="Track.h" compile="0" resource="0" file="Source/Model/Track.h"/>
        <FILE id="track_cpp" name="Track.cpp" compile="1" resource="0" file="Source/Model/Track.cpp"/>
        <FILE id="score_h" name="Score.h" compile="0" resource="0" file="Source/Model/Score.h"/>
        <FILE id="score_cpp" name="Score.cpp" compile="1" resource="0" file="Source/Model/Score.cpp"/>
      </GROUP>
      <GROUP id="{commands_group}" name="Commands">
        <FILE id="command_h" name="Command.h" compile="0" resource="0" file="Source/Commands/Command.h"/>
        <FILE id="commandstack_h" name="CommandStack.h" compile="0" resource="0" file="Source/Commands/CommandStack.h"/>
        <FILE id="commandstack_cpp" name="CommandStack.cpp" compile="1" resource="0" file="Source/Commands/CommandStack.cpp"/>
        <FILE id="editcommands_h" name="EditCommands.h" compile="0" resource="0" file="Source/Commands/EditCommands.h"/>
        <FILE id="editcommands_cpp" name="EditCommands.cpp" compile="1" resource="0" file="Source/Commands/EditCommands.cpp"/>
      </GROUP>
      <GROUP id="{renderer_group}" name="Renderer">
        <FILE id="scorerenderer_h" name="ScoreRenderer.h" compile="0" resource="0" file="Source/Renderer/ScoreRenderer.h"/>
        <FILE id="scorerenderer_cpp" name="ScoreRenderer.cpp" compile="1" resource="0" file="Source/Renderer/ScoreRenderer.cpp"/>
      </GROUP>
      <GROUP id="{editor_group}" name="Editor">
        <FILE id="scoreeditor_h" name="ScoreEditor.h" compile="0" resource="0" file="Source/Editor/ScoreEditor.h"/>
        <FILE id="scoreeditor_cpp" name="ScoreEditor.cpp" compile="1" resource="0" file="Source/Editor/ScoreEditor.cpp"/>
      </GROUP>
      <GROUP id="{playback_group}" name="Playback">
        <FILE id="playbackengine_h" name="PlaybackEngine.h" compile="0" resource="0" file="Source/Playback/PlaybackEngine.h"/>
        <FILE id="playbackengine_cpp" name="PlaybackEngine.cpp" compile="1" resource="0" file="Source/Playback/PlaybackEngine.cpp"/>
      </GROUP>
      <GROUP id="{serialization_group}" name="Serialization">
        <FILE id="scoreserializer_h" name="ScoreSerializer.h" compile="0" resource="0" file="Source/Serialization/ScoreSerializer.h"/>
        <FILE id="scoreserializer_cpp" name="ScoreSerializer.cpp" compile="1" resource="0" file="Source/Serialization/ScoreSerializer.cpp"/>
      </GROUP>
      <GROUP id="{ui_group}" name="UI">
        <FILE id="customlookandfeel_h" name="CustomLookAndFeel.h" compile="0" resource="0" file="Source/UI/CustomLookAndFeel.h"/>
        <FILE id="customlookandfeel_cpp" name="CustomLookAndFeel.cpp" compile="1" resource="0" file="Source/UI/CustomLookAndFeel.cpp"/>
        <FILE id="trackpanel_h" name="TrackPanel.h" compile="0" resource="0" file="Source/UI/TrackPanel.h"/>
        <FILE id="trackpanel_cpp" name="TrackPanel.cpp" compile="1" resource="0" file="Source/UI/TrackPanel.cpp"/>
        <FILE id="inspector_h" name="InspectorPanel.h" compile="0" resource="0" file="Source/UI/InspectorPanel.h"/>
        <FILE id="inspector_cpp" name="InspectorPanel.cpp" compile="1" resource="0" file="Source/UI/InspectorPanel.cpp"/>
        <FILE id="toolbar_h" name="ToolbarComponent.h" compile="0" resource="0" file="Source/UI/ToolbarComponent.h"/>
        <FILE id="toolbar_cpp" name="ToolbarComponent.cpp" compile="1" resource="0" file="Source/UI/ToolbarComponent.cpp"/>
        <FILE id="statusbar_h" name="StatusBar.h" compile="0" resource="0" file="Source/UI/StatusBar.h"/>
        <FILE id="statusbar_cpp" name="StatusBar.cpp" compile="1" resource="0" file="Source/UI/StatusBar.cpp"/>
      </GROUP>
      <FILE id="mainwindow_h" name="MainWindow.h" compile="0" resource="0" file="Source/MainWindow.h"/>
      <FILE id="mainwindow_cpp" name="MainWindow.cpp" compile="1" resource="0" file="Source/MainWindow.cpp"/>
      <FILE id="main_cpp" name="Main.cpp" compile="1" resource="0" file="Source/Main.cpp"/>
    </GROUP>
  </MAINGROUP>
  <JUCEOPTIONS JUCE_STRICT_REFCOUNTEDPOINTER="1" JUCE_USE_CURL="0" JUCE_WEB_BROWSER="0"/>
  <EXPORTFORMATS>
    <VS2022 targetFolder="Builds/VisualStudio2022">
      <CONFIGURATIONS>
        <CONFIGURATION isDebug="1" name="Debug" targetName="BrokenArrowTabStudio"/>
        <CONFIGURATION isDebug="0" name="Release" targetName="BrokenArrowTabStudio"/>
      </CONFIGURATIONS>
      <MODULEPATHS>
        <MODULEPATH id="juce_audio_basics" path=""/>
        <MODULEPATH id="juce_audio_devices" path=""/>
        <MODULEPATH id="juce_audio_formats" path=""/>
        <MODULEPATH id="juce_audio_processors" path=""/>
        <MODULEPATH id="juce_audio_utils" path=""/>
        <MODULEPATH id="juce_core" path=""/>
        <MODULEPATH id="juce_data_structures" path=""/>
        <MODULEPATH id="juce_events" path=""/>
        <MODULEPATH id="juce_graphics" path=""/>
        <MODULEPATH id="juce_gui_basics" path=""/>
        <MODULEPATH id="juce_gui_extra" path=""/>
      </MODULEPATHS>
    </VS2022>
  </EXPORTFORMATS>
  <MODULES>
    <MODULE id="juce_audio_basics" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_audio_devices" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_audio_formats" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_audio_processors" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_audio_utils" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_core" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_data_structures" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_events" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_graphics" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_gui_basics" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_gui_extra" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
  </MODULES>
</JUCERPROJECT>
